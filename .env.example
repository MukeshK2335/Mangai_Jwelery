# ─────────────────────────────────────────────────────────────────────────────
# Mangai Jewelry — environment variable template
#
# Copy this file to `.env.local` (dev machine) and add as env vars on your host
# (Vercel / Netlify → Project → Environment Variables).
#
# NEVER commit real secrets to Git. `.env.local` is already ignored by default
# in Vite projects.
# ─────────────────────────────────────────────────────────────────────────────

# ── Source switch ───────────────────────────────────────────────────────────
# Set to "graph" once the live endpoint (/api/catalog) is deployed with Meta
# credentials. Keep as "local" to preview from src/data/products.json.
VITE_CATALOG_SOURCE=local

# Override the default "/api/catalog" endpoint used when source=graph.
# (Optional. Only set if you host the proxy on a different domain.)
# VITE_CATALOG_ENDPOINT=https://your-proxy.example.com/catalog

# ── Meta Commerce Catalog credentials (SERVER-SIDE ONLY. DO NOT expose these to
#    the browser. Used by api/catalog.ts.) ───────────────────────────────────

# Long-lived System User token with "Catalog Manager" permissions.
# Create one in:
#   https://business.facebook.com → Business Settings → System Users → Generate Token
# Give the System User the "Manage Catalog" role on your catalog first.
META_CATALOG_TOKEN=REPLACE_WITH_YOUR_LONG_LIVED_SYSTEM_USER_TOKEN

# Your Commerce Manager catalog ID (numeric, under Catalog → Settings).
META_CATALOG_ID=REPLACE_WITH_YOUR_CATALOG_ID

# ── Mangai custom columns ────────────────────────────────────────────────────
# JSON map keyed by the item's `retailer_id`.
#
# Meta's catalog doesn't have native columns for our category filter tab
# slug / featured flag / craft tags. This map is MERGED INTO each item's
# `mangai` field before being sent to the browser.
#
# For any SKU not listed here, api/catalog.ts auto-guesses category_slug
# from the Meta `product_type` / `category` string (ring → rings, etc).
#
# The block below covers the 10 SKUs already defined in
# src/data/products.json — keep it in sync as you add new product_item
# entries in Commerce Manager.
MANGAI_CUSTOM_COLUMNS={"MANGAI-001":{"category_slug":"rings","featured":true,"craftsmanship_note":"Cast in Jaipur, hand-set, double-sealed for lasting shine.","tags":["solitaire","everyday","stackable","cz"]},"MANGAI-002":{"category_slug":"necklaces","featured":true,"craftsmanship_note":"Hand-stamped pendant, lobster-clasp closure.","tags":["layered","everyday","pendant","delicate"]},"MANGAI-003":{"category_slug":"earrings","featured":false,"craftsmanship_note":"Hand-brushed finish, nickel-free posts.","tags":["hoops","antique","everyday","hypoallergenic"]},"MANGAI-004":{"category_slug":"bangles","featured":true,"craftsmanship_note":"Hand-etched wave motif inspired by coastal temple architecture.","tags":["kada","statement","temple","bangle"]},"MANGAI-005":{"category_slug":"earrings","featured":true,"craftsmanship_note":"Hand-set Kundan-style inlay, reinforced bezel.","tags":["kundan","drops","wedding","occasion"]},"MANGAI-006":{"category_slug":"rings","featured":false,"craftsmanship_note":"Soft hand engraving, thick plating deposit.","tags":["signet","unisex","everyday","heirloom"]},"MANGAI-007":{"category_slug":"necklaces","featured":false,"craftsmanship_note":"Hand-stamped lotus (Thamarai) motif, Jaipur artisan made.","tags":["lotus","pendant","everyday","antique"]},"MANGAI-008":{"category_slug":"bangles","featured":false,"craftsmanship_note":"Alternating polished and brushed finishes — set of 4.","tags":["stack","set","thin","everyday"]},"MANGAI-009":{"category_slug":"bangles","featured":false,"craftsmanship_note":"Herringbone weave with adjustable slide clasp — preorder only.","tags":["snake","herringbone","minimal","adjustable"]},"MANGAI-010":{"category_slug":"earrings","featured":false,"craftsmanship_note":"Hand-cast bezel setting, surgical steel posts.","tags":["pearl","studs","everyday","classic"]}}
